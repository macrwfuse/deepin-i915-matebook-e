+	/*
+	 * In DSI command mode the panel only latches the pipe contents when it
+	 * receives a frame update request. The atomic commit path sends one
+	 * from intel_pipe_update_end(), but this fast path bypasses that
+	 * function, so a cursor move would otherwise never be latched: the
+	 * pointer only jumps when some unrelated commit happens to send the
+	 * request. mode_flags also tells us whether the panel really runs in
+	 * command mode (TE0/TE1 set) or video mode, where
+	 * icl_dsi_frame_update() is a no-op.
+	 */
+	if (DISPLAY_VER(display) >= 11 &&
+	    intel_crtc_has_type(crtc_state, INTEL_OUTPUT_DSI)) {
+		dsi_frame_update = true;
